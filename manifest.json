{
  "manifest_version": 3,
  "name": "Network Request Inspector",
  "version": "1.0.0",
  "description": "Monitorea y visualiza peticiones enviadas hacia endpoints o dominios específicos.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ver Peticiones Capturadas"
  }
}

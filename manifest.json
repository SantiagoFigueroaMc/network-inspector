{
  "manifest_version": 3,
  "name": "Network Request Inspector",
  "version": "1.0.0",
  "description": "Monitorea y visualiza peticiones enviadas hacia endpoints o dominios específicos.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ver Peticiones Capturadas",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
